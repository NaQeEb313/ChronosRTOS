  29:Core/Src/main.c ****    *
  30:Core/Src/main.c ****    * HSE  = 8 MHz
  31:Core/Src/main.c ****    * PLL  = x9
  32:Core/Src/main.c ****    * SYSCLK = 72 MHz
ARM GAS  /tmp/ccB77SqX.s 			page 2


  33:Core/Src/main.c ****    * APB1 = 36 MHz
  34:Core/Src/main.c ****    * APB2 = 72 MHz
  35:Core/Src/main.c ****    */
  36:Core/Src/main.c ****   SystemClock_Config();
  37:Core/Src/main.c **** 
  38:Core/Src/main.c ****   /* Initialize custom ChronosRTOS GPIO driver */
  39:Core/Src/main.c ****   GPIO_INIT();
  40:Core/Src/main.c **** 
  41:Core/Src/main.c ****   /* Configure custom USART1 driver */
  42:Core/Src/main.c ****   usart1.pUSARTx = USART1;
  43:Core/Src/main.c **** 
  44:Core/Src/main.c ****   usart1.USART_Config.USART_Mode = USART_MODE_TXRX;
  45:Core/Src/main.c **** 
  46:Core/Src/main.c ****   usart1.USART_Config.USART_Baud = USART_STD_BAUD_115200;
  47:Core/Src/main.c **** 
  48:Core/Src/main.c ****   usart1.USART_Config.USART_NoOfStopBits = USART_STOPBITS_1;
  49:Core/Src/main.c **** 
  50:Core/Src/main.c ****   usart1.USART_Config.USART_WordLength = USART_WORDLEN_8BITS;
  51:Core/Src/main.c **** 
  52:Core/Src/main.c ****   usart1.USART_Config.USART_ParityControl = USART_PARITY_DISABLE;
  53:Core/Src/main.c **** 
  54:Core/Src/main.c ****   usart1.USART_Config.USART_HWFlowControl = USART_HW_FLOW_CTRL_NONE;
  55:Core/Src/main.c **** 
  56:Core/Src/main.c ****   USART_Init(&usart1);
  57:Core/Src/main.c **** 
  58:Core/Src/main.c ****   /* Boot message */
  59:Core/Src/main.c ****   USART_SendString(USART1, "ChronosRTOS booted\r\n");
  60:Core/Src/main.c **** 
  61:Core/Src/main.c ****   /* Initialize ChronosRTOS kernel */
  62:Core/Src/main.c **** Kernel_Init();
  63:Core/Src/main.c **** 
  64:Core/Src/main.c **** USART_SendString(USART1, "Kernel initialized\r\n");
  65:Core/Src/main.c **** 
  66:Core/Src/main.c **** Task_Create(TASK_A, 1);
  67:Core/Src/main.c **** Task_Create(TASK_B, 5);
  68:Core/Src/main.c **** Task_Create(TASK_C, 3);
  69:Core/Src/main.c **** Task_Create(TASK_D, 2);
  70:Core/Src/main.c **** Task_Create(TASK_E, 4);
  71:Core/Src/main.c **** 
  72:Core/Src/main.c **** USART_SendString(USART1, "5 tasks created\r\n");
  73:Core/Src/main.c **** 
  74:Core/Src/main.c **** Kernel_Start();
  75:Core/Src/main.c **** 
  76:Core/Src/main.c ****   USART_SendString(USART1, "Kernel started\r\n");
  77:Core/Src/main.c **** 
  78:Core/Src/main.c ****   /* Main should eventually never execute application logic here.
  79:Core/Src/main.c ****    * For the current prototype, context switching has not been
  80:Core/Src/main.c ****    * integrated yet, so remain here.
  81:Core/Src/main.c ****    */
  82:Core/Src/main.c ****   while (1) {
  83:Core/Src/main.c ****   }
  84:Core/Src/main.c **** }
  85:Core/Src/main.c **** 
