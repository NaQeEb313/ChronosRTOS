  25:Core/Src/main.c ****   HAL_Init();
  26:Core/Src/main.c **** 
  27:Core/Src/main.c ****   /* Configure system clock
  28:Core/Src/main.c ****    *
  29:Core/Src/main.c ****    * HSE  = 8 MHz
  30:Core/Src/main.c ****    * PLL  = x9
  31:Core/Src/main.c ****    * SYSCLK = 72 MHz
  32:Core/Src/main.c ****    * APB1 = 36 MHz
ARM GAS  /tmp/ccBAZs41.s 			page 2


  33:Core/Src/main.c ****    * APB2 = 72 MHz
  34:Core/Src/main.c ****    */
  35:Core/Src/main.c ****   SystemClock_Config();
  36:Core/Src/main.c **** 
  37:Core/Src/main.c ****   /* Initialize custom ChronosRTOS GPIO driver */
  38:Core/Src/main.c ****   GPIO_INIT();
  39:Core/Src/main.c **** 
  40:Core/Src/main.c ****   /* Configure custom USART1 driver */
  41:Core/Src/main.c ****   usart1.pUSARTx = USART1;
  42:Core/Src/main.c **** 
  43:Core/Src/main.c ****   usart1.USART_Config.USART_Mode = USART_MODE_TXRX;
  44:Core/Src/main.c **** 
  45:Core/Src/main.c ****   usart1.USART_Config.USART_Baud = USART_STD_BAUD_115200;
  46:Core/Src/main.c **** 
  47:Core/Src/main.c ****   usart1.USART_Config.USART_NoOfStopBits = USART_STOPBITS_1;
  48:Core/Src/main.c **** 
  49:Core/Src/main.c ****   usart1.USART_Config.USART_WordLength = USART_WORDLEN_8BITS;
  50:Core/Src/main.c **** 
  51:Core/Src/main.c ****   usart1.USART_Config.USART_ParityControl = USART_PARITY_DISABLE;
  52:Core/Src/main.c **** 
  53:Core/Src/main.c ****   usart1.USART_Config.USART_HWFlowControl = USART_HW_FLOW_CTRL_NONE;
  54:Core/Src/main.c **** 
  55:Core/Src/main.c ****   USART_Init(&usart1);
  56:Core/Src/main.c **** 
  57:Core/Src/main.c ****   /* Boot message */
  58:Core/Src/main.c ****   USART_SendString(USART1, "ChronosRTOS booted\r\n");
  59:Core/Src/main.c **** 
  60:Core/Src/main.c ****   /* Initialize ChronosRTOS kernel */
  61:Core/Src/main.c ****   Kernel_Init();
  62:Core/Src/main.c **** 
  63:Core/Src/main.c ****   USART_SendString(USART1, "Kernel initialized\r\n");
  64:Core/Src/main.c **** 
  65:Core/Src/main.c ****   /* Start scheduler */
  66:Core/Src/main.c ****   Kernel_Start();
  67:Core/Src/main.c **** 
  68:Core/Src/main.c ****   USART_SendString(USART1, "Kernel started\r\n");
  69:Core/Src/main.c **** 
  70:Core/Src/main.c ****   /* Main should eventually never execute application logic here.
  71:Core/Src/main.c ****    * For the current prototype, context switching has not been
  72:Core/Src/main.c ****    * integrated yet, so remain here.
  73:Core/Src/main.c ****    */
  74:Core/Src/main.c ****   while (1) {
  75:Core/Src/main.c ****   }
  76:Core/Src/main.c **** }
